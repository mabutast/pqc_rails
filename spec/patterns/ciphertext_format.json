          "find": "now <= deadline",
          "replace": "now < deadline",
          "result": "killed"
        },
        {
          "id": "drop-nil",
          "kind": "打ち切りを消す",
          "file": "lib/pqc_rails/ciphertext_format.rb",
          "find": "return if deadline ? now <= deadline : write_legacy?",
          "replace": "return if deadline.nil? || now <= deadline",
          "result": "killed"
        },
