        },
        {
          "id": "v0-overrides-deadline",
          "kind": "条件を反転する・常に真／偽にする",
          "file": "lib/pqc_rails/ciphertext_format.rb",
          "find": "return if deadline ? now <= deadline : write_legacy?",
          "replace": "return if write_legacy? || (deadline && now <= deadline)",
