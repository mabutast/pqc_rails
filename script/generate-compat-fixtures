#!/usr/bin/env ruby
# frozen_string_literal: true

# spec/fixtures/compat/ の検査データ(以前の版が書いた暗号文)を作る。
#
# 引数の lib ディレクトリにある pqc_rails を読み込み、その版の鍵生成で DB 用とセッション用の鍵を作り、
# ActiveRecord::Encryption で DB カラムに書いた値と、セッション Cookie の値を JSON で標準出力に出す。
# DB の値は、Rails の Encryptor が圧縮しない短い値と、圧縮する長い値(140 バイト超)の2つを書く。
# 鍵の値はその版の KeySource.encode の形(0.3.0 以前は認証鍵を持たない2要素)で残す。
# 2つ目の引数は pq_alg_name(既定はその版の既定のアルゴリズム)。旧形式(v0)は鍵の導出にアルゴリズム名を
# 指定された書き方のまま使うため、利用者に案内した書き方ごとに検査データを持つ。
# written_by には、lib がリリースのタグにあればそのタグを、無ければ「unreleased」とコミットを記録する。
#
# リリースのタグで書いた検査データは作り直さない。作り直すと、その版が書いたデータを今のコードで
# 読めるかを確かめられなくなる。unreleased の検査データは、その形式を初めて含む版をリリースした後に、
# そのタグで作り直す。新しい形式を足した時は、その形式のファイルを足す。
#
# 使い方(リポジトリの直下で):
#   git worktree add --detach tmp/compat-v0.3.0 v0.3.0
#   bundle exec ruby script/generate-compat-fixtures tmp/compat-v0.3.0/lib > spec/fixtures/compat/pqc_rails-0.3.0.json
#   bundle exec ruby script/generate-compat-fixtures tmp/compat-v0.3.0/lib ml_kem_512 \
#     > spec/fixtures/compat/pqc_rails-0.3.0-ml_kem_512.json
#   bundle exec ruby script/generate-compat-fixtures lib > spec/fixtures/compat/format-v1.json
#   git worktree remove tmp/compat-v0.3.0

require "json"
require "open3"
require "active_record"
require "sqlite3"

lib = File.expand_path(ARGV.fetch(0) { abort "usage: #{$PROGRAM_NAME} <lib directory of pqc_rails>" })
require File.join(lib, "pqc_rails")

RECORD_PLAINTEXTS = [
  "pqc_rails compat fixture: 長く保存されるデータ",
  "pqc_rails compat fixture (compressed): #{'暗号文の互換性を確かめるための長い値。' * 8}"
].freeze
SESSION_DATA = { "session_id" => "compat-fixture-session", "user_id" => 42, "flash" => "保存した" }.freeze
PQ_ALG_NAME = ARGV[1] ? ARGV[1].to_sym : PqcRails::Cipher::DEFAULT_PQ_ALG_NAME

def written_by(dir)
  tag, tag_status = Open3.capture2("git", "-C", dir, "describe", "--tags", "--exact-match", err: File::NULL)
  return "pqc_rails #{tag.strip}" if tag_status.success?

  commit, = Open3.capture2("git", "-C", dir, "rev-parse", "--short", "HEAD")
  "unreleased (commit #{commit.strip})"
end

def generate_keypair
  PqcRails::HybridKem.open(PQ_ALG_NAME, &:generate_keypair)
end

def write_records(record_key)
  ENV["PQC_RECORD_KEY"] = record_key
  ENV.delete("PQC_RECORD_PREVIOUS_KEYS")
  PqcRails::ActiveRecord::Context.install!(pq_alg_name: PQ_ALG_NAME)

  ActiveRecord::Base.establish_connection(adapter: "sqlite3", database: ":memory:")
  ActiveRecord::Migration.verbose = false
  ActiveRecord::Schema.define { create_table(:compat_records) { |t| t.text :secret } }
  model = Class.new(ActiveRecord::Base) do
    self.table_name = "compat_records"
    encrypts :secret
  end

  RECORD_PLAINTEXTS.map do |plaintext|
    record = model.create!(secret: plaintext)
    { "plaintext" => plaintext, "stored_value" => record.ciphertext_for(:secret) }
  end
end

record_key = PqcRails::KeySource.encode(generate_keypair)
session_keypair = generate_keypair

fixture = {
  "written_by" => written_by(lib),
  "pq_alg_name" => PQ_ALG_NAME.to_s,
  "record" => {
    "key" => record_key,
    "values" => write_records(record_key)
  },
  "session" => {
    "key" => PqcRails::KeySource.encode(session_keypair),
    "data" => SESSION_DATA,
    "cookie_value" => PqcRails::Session::Encryptor.new(session_keypair, pq_alg_name: PQ_ALG_NAME).encrypt(SESSION_DATA)
  }
}

puts JSON.pretty_generate(fixture)
